{
  "id": "flow-1",
  "name": "My First Flow",
  "description": "A simple flow to demonstrate the FBP engine.",
  "nodes": [
    {
      "id": "node-1",
      "type": "GeneratorNode",
      "config": {
        "message": "Hello, FBP!",
        "interval": "1000"
      }
    },
    {
      "id": "node-2",
      "type": "LogNode",
      "config": {}
    }
  ],
  "connections": [
    {
      "from": "node-1:out",
      "to": "node-2:in"
    }
  ]
}
